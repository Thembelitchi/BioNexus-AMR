# Neo4j connection (used by the API, CLI and docker-compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# Optional tuning
BIONEXUS_BATCH_SIZE=500
BIONEXUS_CONNECT_ATTEMPTS=5
BIONEXUS_CONNECT_BACKOFF=2
BIONEXUS_TX_RETRY_SECONDS=30
BIONEXUS_MAX_UPLOAD_BYTES=52428800
BIONEXUS_CORS_ORIGINS=http://localhost:3000
BIONEXUS_LOG_LEVEL=INFO
