# Neo4j connection (used by the API, CLI and docker-compose)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please
NEO4J_DATABASE=neo4j

# POPIA pseudonymisation at ingest. When set (at least 16 characters), patient
# and admission IDs are replaced by keyed HMAC-SHA256 hashes and exact ages by
# age bands before anything reaches the graph. Keep the key secret and stable:
# the same key maps the same patient to the same pseudonym across loads.
# BIONEXUS_PSEUDONYMISATION_KEY=

# Optional tuning
BIONEXUS_BATCH_SIZE=500
BIONEXUS_CONNECT_ATTEMPTS=5
BIONEXUS_CONNECT_BACKOFF=2
BIONEXUS_TX_RETRY_SECONDS=30
BIONEXUS_MAX_UPLOAD_BYTES=52428800
BIONEXUS_CORS_ORIGINS=http://localhost:3000
BIONEXUS_LOG_LEVEL=INFO
