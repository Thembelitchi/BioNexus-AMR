  {s: 616, e: 4, p: {}},
  {s: 617, e: 20, p: {}},
  {s: 619, e: 21, p: {}},
  {s: 620, e: 2, p: {}},
  {s: 621, e: 11, p: {}},
  {s: 622, e: 5, p: {}},
  {s: 623, e: 5, p: {}},
  {s: 624, e: 17, p: {}},
  {s: 625, e: 8, p: {}},
  {s: 626, e: 5, p: {}},
  {s: 626, e: 11, p: {}},
  {s: 627, e: 11, p: {}},
  {s: 628, e: 11, p: {}},
  {s: 629, e: 8, p: {}}
] AS row
MATCH (a:BioNexusImport {import_id: row.s}), (b:BioNexusImport {import_id: row.e})
CREATE (a)-[r:TREATED_WITH]->(b) SET r += row.p;

// ---- remove the temporary import label
MATCH (n:BioNexusImport) REMOVE n:BioNexusImport, n.import_id;
DROP CONSTRAINT bionexus_import_id IF EXISTS;
