// ---- schema
CREATE CONSTRAINT patient_id IF NOT EXISTS FOR (n:Patient) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT encounter_id IF NOT EXISTS FOR (n:Encounter) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT location_event_id IF NOT EXISTS FOR (n:LocationEvent) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT ward_key IF NOT EXISTS FOR (n:Ward) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT facility_code IF NOT EXISTS FOR (n:Facility) REQUIRE n.code IS UNIQUE;
CREATE CONSTRAINT isolate_id IF NOT EXISTS FOR (n:Isolate) REQUIRE n.id IS UNIQUE;
CREATE CONSTRAINT pathogen_taxid IF NOT EXISTS FOR (n:Pathogen) REQUIRE n.ncbi_taxid IS UNIQUE;
CREATE CONSTRAINT antibiotic_atc IF NOT EXISTS FOR (n:Antibiotic) REQUIRE n.atc_code IS UNIQUE;
CREATE CONSTRAINT sequence_type_key IF NOT EXISTS FOR (n:SequenceType) REQUIRE n.key IS UNIQUE;
CREATE CONSTRAINT gene_aro IF NOT EXISTS FOR (n:Gene) REQUIRE n.aro_id IS UNIQUE;
CREATE CONSTRAINT mge_key IF NOT EXISTS FOR (n:MobileGeneticElement) REQUIRE n.key IS UNIQUE;
CREATE INDEX isolate_collected IF NOT EXISTS FOR (n:Isolate) ON (n.collected);
CREATE INDEX location_event_timestamp IF NOT EXISTS FOR (n:LocationEvent) ON (n.timestamp);
CREATE INDEX mge_replicon IF NOT EXISTS FOR (n:MobileGeneticElement) ON (n.replicon);
CREATE CONSTRAINT bionexus_import_id IF NOT EXISTS FOR (n:BioNexusImport) REQUIRE n.import_id IS UNIQUE;

